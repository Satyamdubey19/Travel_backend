generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id                   String             @id @default(uuid())
  hostId               String
  slug                 String             @unique
  title                String
  description          String?
  city                 String
  state                String?
  country              String             @default("India")
  area                 String?
  category             ActivityCategory
  difficulty           ActivityDifficulty @default(EASY)
  price                Decimal            @db.Decimal(10, 2)
  originalPrice        Decimal?           @db.Decimal(10, 2)
  duration             String
  groupSizeMin         Int                @default(1)
  groupSizeMax         Int                @default(20)
  totalSlots           Int                @default(20)
  availableSlots       Int                @default(20)
  language             String             @default("English")
  imageUrl             String?
  images               String[]
  highlights           String[]
  included             String[]
  excluded             String[]
  meetingPoint         String?
  meetingLat           Float?
  meetingLng           Float?
  cancellationPolicy   String?
  status               ListingStatus      @default(PENDING_REVIEW)
  isActive             Boolean            @default(true)
  isApproved           Boolean            @default(false)
  averageRating        Float              @default(0)
  totalReviews         Int                @default(0)
  totalBookings        Int                @default(0)
  // Moderation fields
  submittedForReviewAt DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  archivedAt           DateTime?
  deletedAt            DateTime?
  reviewedAt           DateTime?
  reviewedById         String?
  rejectionReason      String?
  moderationNotes      String?
  lastReviewedStatus   ListingStatus?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  Host                 Host               @relation(fields: [hostId], references: [id], onDelete: Cascade)
  ReviewedBy           User?              @relation("ActivityReviewer", fields: [reviewedById], references: [id])
  ActivityBooking      ActivityBooking[]
  ActivitySlot         ActivitySlot[]
  Review               Review[]
  WishlistItem         WishlistItem[]

  @@index([city, category])
  @@index([hostId])
  @@index([status, isActive, isApproved])
  @@index([reviewedById])
  @@index([deletedAt])
}

model ActivityBooking {
  id                      String                    @id @default(uuid())
  bookingCode             String                    @unique
  idempotencyKey          String?                   @unique
  userId                  String
  hostId                  String
  activityId              String
  slotId                  String?
  date                    DateTime
  startTime               String
  guestCount              Int                       @default(1)
  privateGroup            Boolean                   @default(false)
  subtotal                Decimal                   @db.Decimal(10, 2)
  taxes                   Decimal                   @default(0) @db.Decimal(10, 2)
  totalAmount             Decimal                   @db.Decimal(10, 2)
  currency                String                    @default("INR")
  status                  BookingStatus             @default(PENDING)
  expiresAt               DateTime?
  contactName             String
  contactEmail            String
  contactPhone            String
  specialRequests         String?
  cancellationReason      String?
  cancelledAt             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  Activity                Activity                  @relation(fields: [activityId], references: [id])
  Host                    Host                      @relation(fields: [hostId], references: [id])
  ActivitySlot            ActivitySlot?             @relation(fields: [slotId], references: [id])
  User                    User                      @relation(fields: [userId], references: [id])
  ActivityBookingGuest    ActivityBookingGuest[]
  ActivityBookingTimeline ActivityBookingTimeline[]
  ActivityPayment         ActivityPayment?
  ActivityRefund          ActivityRefund?
  Review                  Review?

  @@index([activityId])
  @@index([hostId])
  @@index([status])
  @@index([userId])
  @@index([expiresAt])
}

model ActivityBookingGuest {
  id              String          @id @default(uuid())
  bookingId       String
  type            GuestType       @default(ADULT)
  firstName       String
  lastName        String?
  age             Int?
  createdAt       DateTime        @default(now())
  ActivityBooking ActivityBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model ActivityBookingTimeline {
  id              String           @id @default(uuid())
  bookingId       String
  type            BookingEventType
  title           String
  message         String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  ActivityBooking ActivityBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model ActivityPayment {
  id                String          @id @default(uuid())
  activityBookingId String          @unique
  userId            String
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("INR")
  status            PaymentStatus   @default(PENDING)
  provider          String          @default("razorpay")
  providerOrderId   String?         @unique
  providerPaymentId String?         @unique
  transactionId     String?         @unique
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  ActivityBooking   ActivityBooking @relation(fields: [activityBookingId], references: [id], onDelete: Cascade)
  ActivityRefund    ActivityRefund?

  @@index([status])
}

model ActivityRefund {
  id                String           @id @default(uuid())
  activityBookingId String           @unique
  activityPaymentId String?          @unique
  requestedAmount   Decimal          @db.Decimal(10, 2)
  approvedAmount    Decimal?         @db.Decimal(10, 2)
  currency          String           @default("INR")
  status            String           @default("REVIEW_PENDING")
  reason            String?
  policySnapshot    String
  providerRefundId  String?
  failureReason     String?
  createdAt         DateTime         @default(now())
  processedAt       DateTime?
  ActivityBooking   ActivityBooking  @relation(fields: [activityBookingId], references: [id], onDelete: Cascade)
  ActivityPayment   ActivityPayment? @relation(fields: [activityPaymentId], references: [id])

  @@index([status, createdAt])
}

model ActivitySlot {
  id              String            @id @default(uuid())
  activityId      String
  date            DateTime          @db.Date
  startTime       String
  totalSpots      Int               @default(20)
  bookedSpots     Int               @default(0)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  ActivityBooking ActivityBooking[]
  Activity        Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, date, startTime])
  @@index([activityId, date])
}

model AdminProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  department  String?
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Amenity {
  id       String  @id @default(uuid())
  name     String  @unique
  icon     String?
  category String?
}

model AuditLog {
  id        String        @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  severity  AuditSeverity @default(INFO)
  module    String?
  requestId String?
  endpoint  String?
  method    String?
  createdAt DateTime      @default(now())
  User      User?         @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
  @@index([severity])
  @@index([module])
}

model Booking {
  id                     String             @id @default(uuid())
  bookingCode            String             @unique
  userId                 String
  hostId                 String
  tourId                 String?
  checkIn                DateTime?
  checkOut               DateTime?
  totalGuests            Int                @default(1)
  adults                 Int                @default(1)
  children               Int                @default(0)
  infants                Int                @default(0)
  contactName            String
  contactEmail           String
  contactPhone           String
  specialRequests        String?
  riskAcknowledgedAt     DateTime?
  riskDisclosureSnapshot Json?
  couponId               String?
  TourParticipant        TourParticipant[]
  subtotal               Decimal            @db.Decimal(10, 2)
  taxes                  Decimal            @default(0) @db.Decimal(10, 2)
  discount               Decimal            @default(0) @db.Decimal(10, 2)
  totalAmount            Decimal            @db.Decimal(10, 2)
  currency               String             @default("INR")
  status                 BookingStatus      @default(PENDING)
  // Pending bookings can expire if payment is not completed before this time.
  expiresAt              DateTime?
  cancellationReason     String?
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  Coupon                 Coupon?            @relation(fields: [couponId], references: [id])
  Host                   Host               @relation(fields: [hostId], references: [id])
  Tour                   Tour?              @relation(fields: [tourId], references: [id], onDelete: Restrict)
  User                   User               @relation(fields: [userId], references: [id])
  BookingTimeline        BookingTimeline[]
  CouponRedemption       CouponRedemption[]
  Payment                Payment?
  Review                 Review?
  Incident               Incident[]

  @@index([bookingCode])
  @@index([hostId])
  @@index([status])
  @@index([checkIn, checkOut])
  @@index([tourId])
  @@index([userId])
}

model BookingTimeline {
  id        String           @id @default(uuid())
  bookingId String
  type      BookingEventType
  title     String
  message   String?
  metadata  Json?
  createdAt DateTime         @default(now())
  Booking   Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Coupon {
  id               String             @id @default(uuid())
  code             String             @unique
  name             String
  description      String?
  type             CouponType
  value            Decimal            @db.Decimal(10, 2)
  maxDiscount      Decimal?           @db.Decimal(10, 2)
  minOrderAmount   Decimal            @default(0) @db.Decimal(10, 2)
  usageLimit       Int?
  usedCount        Int                @default(0)
  perUserLimit     Int                @default(1)
  startsAt         DateTime?
  expiresAt        DateTime?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Booking          Booking[]
  CouponRedemption CouponRedemption[]

  @@index([isActive, expiresAt])
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  bookingId String?
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  Booking   Booking? @relation(fields: [bookingId], references: [id])
  Coupon    Coupon   @relation(fields: [couponId], references: [id])
  User      User     @relation(fields: [userId], references: [id])

  @@unique([couponId, userId, bookingId])
  @@index([couponId])
  @@index([userId])
}

model Host {
  id                String            @id @default(uuid())
  userId            String            @unique
  businessName      String?
  businessType      BusinessType      @default(INDIVIDUAL)
  hostType          HostType          @default(MULTI_SERVICE)
  bio               String?
  website           String?
  logoUrl           String?
  contactEmail      String?
  supportPhone      String?
  address           String?
  city              String?
  state             String?
  country           String?
  postalCode        String?
  gstNumber         String?
  registrationNo    String?
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  isVerified        Boolean           @default(false)
  isApproved        Boolean           @default(false)
  isActive          Boolean           @default(true)
  kycStatus         KycStatus         @default(NOT_SUBMITTED)
  totalEarnings     Decimal           @default(0) @db.Decimal(12, 2)
  averageRating     Float             @default(0)
  joinedAt          DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  // Moderation fields
  reviewedAt        DateTime?
  reviewedById      String?
  rejectionReason   String?
  moderationNotes   String?
  suspendedAt       DateTime?
  deactivatedAt     DateTime?
  Activity          Activity[]
  ActivityBooking   ActivityBooking[]
  Booking           Booking[]
  User              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ReviewedBy        User?             @relation("HostReviewer", fields: [reviewedById], references: [id])
  KycApplication    KycApplication[]
  Payment           Payment[]
  Payout            Payout[]
  Rental            Rental[]
  RentalBooking     RentalBooking[]
  Review            Review[]
  Tour              Tour[]
  Incident          Incident[]

  @@index([city])
  @@index([isApproved, isActive])
  @@index([kycStatus])
  @@index([reviewedById])
}

model KycApplication {
  id                   String    @id @default(uuid())
  hostId               String
  status               KycStatus @default(PENDING)
  firstName            String
  lastName             String
  dateOfBirth          DateTime?
  nationality          String?
  idType               String
  idNumber             String
  idFrontUrl           String?
  idBackUrl            String?
  addressProofUrl      String?
  businessDocUrl       String?
  submittedAt          DateTime  @default(now())
  reviewedById         String?
  reviewedAt           DateTime?
  rejectionReason      String?
  reviewNotes          String?
  resubmissionAllowed  Boolean   @default(false)
  resubmissionDeadline DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  Host                 Host      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  ReviewedBy           User?     @relation("KycReviewer", fields: [reviewedById], references: [id])
  id                       String    @id @default(uuid())
  hostId                   String
  status                   KycStatus @default(PENDING)
  hostType                 String    @default("INDIVIDUAL")
  firstName                String
  lastName                 String
  dateOfBirth              DateTime?
  nationality              String?
  idType                   String
  idNumber                 String
  idFrontUrl               String?
  idBackUrl                String?
  selfieUrl                String?
  streetAddress            String?
  city                     String?
  state                    String?
  postalCode               String?
  country                  String?   @default("India")
  addressProofType         String?
  addressProofUrl          String?
  businessName             String?
  gstin                    String?
  businessPan              String?
  businessDocUrl           String?
  bankAccountName          String?
  bankAccountNumber        String?
  bankIfsc                 String?
  bankName                 String?
  cancelledChequeUrl       String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  safetyCertUrl            String?
  agreedToHostSafetyPolicy Boolean   @default(false)
  safetyPolicyAgreedAt     DateTime?
  submittedAt              DateTime  @default(now())
  reviewedById             String?
  reviewedAt               DateTime?
  rejectionReason          String?
  reviewNotes              String?
  resubmissionAllowed      Boolean   @default(false)
  resubmissionDeadline     DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  Host                     Host      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  ReviewedBy               User?     @relation("KycReviewer", fields: [reviewedById], references: [id])

  @@index([hostId])
  @@index([status])
  @@index([reviewedById])
}

model Notification {
  id                   String                 @id @default(uuid())
  userId               String
  type                 NotificationType
  title                String
  message              String
  data                 Json?
  isRead               Boolean                @default(false)
  readAt               DateTime?
  createdAt            DateTime               @default(now())
  User                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  NotificationDelivery NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model NotificationDelivery {
  id             String                      @id @default(uuid())
  notificationId String
  userId         String
  channel        NotificationDeliveryChannel @default(EMAIL)
  status         NotificationDeliveryStatus  @default(PENDING)
  attempts       Int                         @default(0)
  availableAt    DateTime                    @default(now())
  lockedAt       DateTime?
  deliveredAt    DateTime?
  lastError      String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  Notification   Notification                @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  User           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, availableAt])
  @@index([userId, status])
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  userId            String
  hostId            String
  amount            Decimal       @db.Decimal(10, 2)
  hostEarnings      Decimal       @db.Decimal(10, 2)
  platformFee       Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  provider          String        @default("razorpay")
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  transactionId     String?       @unique
  paidAt            DateTime?
  refundedAt        DateTime?
  refundReason      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  Booking           Booking       @relation(fields: [bookingId], references: [id])
  Host              Host          @relation(fields: [hostId], references: [id])
  User              User          @relation(fields: [userId], references: [id])

  @@index([hostId])
  @@index([status])
  @@index([userId])
}

model PaymentWebhookEvent {
  id                String    @id @default(uuid())
  provider          String    @default("razorpay")
  eventId           String    @unique
  eventType         String
  providerOrderId   String?
  providerPaymentId String?
  status            String    @default("PROCESSING")
  failureReason     String?
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?

  @@index([providerOrderId])
  @@index([status, receivedAt])
}

model Payout {
  id            String       @id @default(uuid())
  hostId        String
  amount        Decimal      @db.Decimal(10, 2)
  currency      String       @default("INR")
  bankName      String?
  accountNumber String?
  ifscCode      String?
  status        PayoutStatus @default(PENDING)
  transactionId String?
  requestedAt   DateTime     @default(now())
  processedAt   DateTime?
  processedById String?
  failureReason String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  Host          Host         @relation(fields: [hostId], references: [id])
  User          User?        @relation(fields: [processedById], references: [id])

  @@index([hostId])
  @@index([status])
}

model Post {
  id          String        @id @default(uuid())
  userId      String
  tourId      String?
  imageUrl    String
  caption     String?
  viewCount   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Tour        Tour?         @relation(fields: [tourId], references: [id])
  User        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  PostComment PostComment[]
  PostLike    PostLike[]

  @@index([userId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  Post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  deviceId   String?
  deviceName String?
  ipAddress  String?
  userAgent  String?
  isRevoked  Boolean   @default(false)
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([isRevoked])
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  deviceId   String?
  deviceName String?
  deviceType String?
  ipAddress  String?
  userAgent  String?
  lastSeenAt DateTime @default(now())
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([isActive])
  @@index([lastSeenAt])
}

model OtpVerification {
  id         String     @id @default(uuid())
  email      String?
  phone      String?
  otpHash    String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email])
  @@index([phone])
  @@index([purpose])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([usedAt])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String?
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([success])
  @@index([createdAt])
}

model UserDevice {
  id               String   @id @default(uuid())
  userId           String
  deviceId         String
  deviceName       String?
  deviceType       String   @default("browser")
  browser          String?
  os               String?
  ipAddress        String?
  userAgent        String?
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  isCurrent        Boolean  @default(false)
  isActive         Boolean  @default(true)
  refreshTokenHash String?
  User             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
  @@index([isActive])
}

model EmailChangeRequest {
  id        String   @id @default(uuid())
  userId    String
  oldEmail  String
  newEmail  String
  otpHash   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([newEmail])
  @@index([expiresAt])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  userId    String?
  type      String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Rental {
  id                   String          @id @default(uuid())
  hostId               String
  slug                 String          @unique
  title                String
  vehicleType          VehicleType
  brand                String
  model                String?
  year                 Int?
  city                 String
  state                String?
  country              String          @default("India")
  pickupArea           String?
  totalUnits           Int             @default(1)
  availableUnits       Int             @default(1)
  imageUrl             String?
  images               String[]
  pricePerDay          Decimal         @db.Decimal(10, 2)
  originalPrice        Decimal?        @db.Decimal(10, 2)
  cancellationPolicy   String?
  status               ListingStatus   @default(PENDING_REVIEW)
  isActive             Boolean         @default(true)
  isApproved           Boolean         @default(false)
  averageRating        Float           @default(0)
  totalReviews         Int             @default(0)
  totalBookings        Int             @default(0)
  // Moderation fields
  submittedForReviewAt DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  archivedAt           DateTime?
  deletedAt            DateTime?
  reviewedAt           DateTime?
  reviewedById         String?
  rejectionReason      String?
  moderationNotes      String?
  lastReviewedStatus   ListingStatus?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  Host                 Host            @relation(fields: [hostId], references: [id], onDelete: Cascade)
  ReviewedBy           User?           @relation("RentalReviewer", fields: [reviewedById], references: [id])
  RentalBooking        RentalBooking[]
  RentalDetails        RentalDetails?
  Review               Review[]
  WishlistItem         WishlistItem[]

  @@index([city, vehicleType])
  @@index([hostId])
  @@index([status, isActive, isApproved])
  @@index([reviewedById])
  @@index([deletedAt])
}

model RentalBooking {
  id                    String                  @id @default(uuid())
  bookingCode           String                  @unique
  idempotencyKey        String?                 @unique
  userId                String
  hostId                String
  rentalId              String
  pickupDate            DateTime
  returnDate            DateTime
  pickupTime            String?
  days                  Int
