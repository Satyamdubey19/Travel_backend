// ==========================================
// Enterprise Single Sign-On (SSO) Module
// ==========================================

enum SsoProtocol {
  OIDC
  SAML2
}

enum SsoIdpProvider {
  ENTRA_ID
  OKTA
  GOOGLE_WORKSPACE
  ONELOGIN
  GENERIC_SAML
  GENERIC_OIDC
}

model Organization {
  id          String                 @id @default(uuid())
  slug        String                 @unique
  name        String
  domain      String                 @unique
  isActive    Boolean                @default(true)
  ssoConfig   SsoConfiguration?
  members     OrganizationMember[]
  auditLogs   SsoAuditLog[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([domain, isActive])
}

model SsoConfiguration {
  id                       String         @id @default(uuid())
  organizationId           String         @unique
  organization             Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  protocol                 SsoProtocol    @default(OIDC)
  provider                 SsoIdpProvider @default(ENTRA_ID)
  
  // OIDC Configuration
  issuerUrl                String?
  clientId                 String?
  clientSecretEncrypted    String?
  
  // SAML 2.0 Configuration
  entryPoint               String?
  issuer                   String?
  cert                     String?        @db.Text
  logoutUrl                String?
  
  // Policies & Provisioning
  jitEnabled               Boolean        @default(true)
  defaultRole              Role           @default(USER)
  inactivityTimeoutMinutes Int            @default(30)
  enforceMfaAtIdp          Boolean        @default(true)
  allowPasswordFallback    Boolean        @default(false)
  
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([organizationId])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  employeeId     String?
  department     String?
  role           String       @default("EMPLOYEE")
  isCurrent      Boolean      @default(true)
  joinedAt       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([organizationId, employeeId])
  @@index([organizationId, isCurrent])
  @@index([userId])
}

model SsoAuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  email          String
  eventType      String
  protocol       SsoProtocol
  idpEntityId    String?
  ipAddress      String?
  userAgent      String?
  failureReason  String?
  metadata       Json?
  timestamp      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, timestamp])
  @@index([email, eventType])
  @@index([userId])
}

enum PolicyType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  HOST_SAFETY_AGREEMENT
  TRAVELER_SAFETY_POLICY
  CANCELLATION_POLICY
}

model Policy {
  id            String          @id @default(uuid())
  type          PolicyType
  title         String
  version       String
  summary       String?         @db.Text
  content       String          @db.Text
  isActive      Boolean         @default(true)
  effectiveDate DateTime        @default(now())
  publishedById String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  PublishedBy   User?           @relation("PolicyPublisher", fields: [publishedById], references: [id])
  Consents      PolicyConsent[]

  @@unique([type, version])
  @@index([type, isActive])
  @@index([publishedById])
}

model PolicyConsent {
  id            String     @id @default(uuid())
  userId        String
  policyId      String
  policyType    PolicyType
  policyVersion String
  ipAddress     String?
  userAgent     String?
  context       String     @default("SIGNUP")
  consentedAt   DateTime   @default(now())
  User          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  Policy        Policy     @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([userId, policyType])
  @@index([policyId])
  @@index([consentedAt])
}

