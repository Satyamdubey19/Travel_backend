n# Travels Pro backend — local development template
# Copy to .env and replace every your_* value through local secret storage.
# Never commit real credentials, tokens, personal data, or production URLs.

# Location and database
LOCATION_API_KEY=your_location_api_key
OPENCAGE_API_KEY=your_opencage_api_key
DATABASE_URL=your_postgresql_connection_string
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Server-side identity and data-protection secrets (unique values, 32+ characters)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret
JWT_SECRET=your_jwt_secret
JWT_ACCESS_SECRET=your_jwt_access_secret

# Google identity handoff
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI and email
GROQ_API_KEY=your_groq_api_key
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=Travels Pro <onboarding@your-verified-domain.example>

# Media storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=your_cloudinary_url

# Payments — test values only for local development
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_public_key_id
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# Scheduled jobs
CRON_SECRET=your_cron_secret
AADHAAR_HASH_SECRET=your_aadhaar_hash_secret
KYC_ENCRYPTION_KEY=your_kyc_encryption_key
